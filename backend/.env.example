# Backend API
NODE_ENV=development
# Public frontend URL used for Checkout success/cancel redirects.
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=swiss_market_session
SESSION_TTL_DAYS=7
# Use a long random secret for signing any future signed tokens; session cookies themselves are opaque random tokens.
APP_SECRET=replace-with-at-least-32-random-characters

# Database — MongoDB Atlas recommended. Transactions require a replica set.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/swiss_marketplace?retryWrites=true&w=majority

# Authentication / seed accounts
BCRYPT_ROUNDS=12
# Google sign-in (optional). Create a Web application OAuth client in Google Cloud Console
# and register GOOGLE_REDIRECT_URI (default: ${APP_URL}/api/auth/google/callback, on the frontend origin).
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# seed:admin requires a unique password of at least 14 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=DemoUser@12345
TEST_USER_INITIAL_COINS=100000

# Wallet packages. By default USD packages follow 1 coin = $1 reference value.
COIN_TOPUP_CURRENCY=usd
MIN_TOPUP_AMOUNT_MINOR=500
# For non-USD currencies, supply explicit package prices in smallest currency units; do not assume USD and CHF are equal.
# The example values are sample configuration only, not an exchange-rate quote or business recommendation.
COIN_PACKAGE_PRICES_JSON={"5":550,"100":9900,"200":19500,"300":29000,"400":38000}

# Stripe — test keys during development; webhook signing secret must match Stripe CLI/dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_FEE_BPS=800
AUCTION_FEE_AMOUNT_MINOR=500
AUCTION_FEE_CURRENCY=chf

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=12

# LiveKit (server-only)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud

# Transactional email for 60-second, single-use password reset codes.
# Resend is used when RESEND_API_KEY and EMAIL_FROM are set. Without them,
# development logs the code in the backend terminal and shows it on the reset
# page; production refuses to issue codes until delivery is configured.
RESEND_API_KEY=
# Legacy alias; RESEND_API_KEY takes precedence.
EMAIL_PROVIDER_API_KEY=
# Must be a verified Resend sender, e.g. MarketHaus <security@your-domain.ch>
EMAIL_FROM=
# Local-only fallback: when no email provider is configured, show the reset code
# on screen and in the backend console. Ignored unless APP_URL is localhost.
# Never set this for a deployed environment.
ALLOW_DEV_EMAIL_CODES=true

# Operational safety
RATE_LIMIT_WINDOW_SECONDS=60
# Extra browser origins allowed to call the API (comma-separated, scheme + host only).
# Same-origin and APP_URL are always trusted; localhost is trusted in development.
ALLOWED_ORIGINS=
# Maximum JSON request body size in KB (clamped 16-5120, default 1024).
MAX_JSON_BODY_KB=1024
